-- Immersive Run Timer. Persistent, save-safe and independent of the UI layout.
local HUD
local KEY = "sep_immersive_run_timer.seconds"

function on_game_start()
  RegisterScriptCallback("actor_on_first_update", function() activate_timer() end)
  RegisterScriptCallback("actor_on_net_destroy", function() deactivate_timer() end)
end

function activate_timer()
  if HUD then return end
  HUD = SepRunTimer()
  get_hud():AddDialogToRender(HUD)
end

function deactivate_timer()
  if HUD then get_hud():RemoveDialogToRender(HUD); HUD = nil end
end

class "SepRunTimer" (CUIScriptWnd)
function SepRunTimer:__init() super()
  self:SetWndRect(Frect():set(0, 0, 1024, 768))
  -- Match NewRunTimer: when this addon is first installed mid-run, begin from
  -- Anomaly's recorded time for the current playthrough instead of 00:00:00.
  self.seconds = load_var(db.actor, KEY)
  if not self.seconds then
    self.seconds = utils_obj.time_spent_in_zone(1) / level.get_time_factor()
    save_var(db.actor, KEY, self.seconds)
  end
  self.last = time_global()
  local xml = CScriptXmlInit(); xml:ParseFile("sep_immersive_run_timer.xml")
  self.panel = xml:InitStatic("panel", self)
  self.time = xml:InitTextWnd("panel:time", self.panel)
  self:refresh_position()
end

function SepRunTimer:refresh_position()
  local x = ui_mcm and ui_mcm.get("sep_immersive_run_timer/main/pos_x") or 850
  local y = ui_mcm and ui_mcm.get("sep_immersive_run_timer/main/pos_y") or 25
  self.panel:SetWndPos(vector2():set(x, y))
end

function SepRunTimer:Update()
  CUIScriptWnd.Update(self)
  local now = time_global()
  if now - self.last < 1000 then return end
  self.seconds = self.seconds + math.floor((now - self.last) / 1000)
  self.last = now
  save_var(db.actor, KEY, self.seconds)
  local h = math.floor(self.seconds / 3600)
  local m = math.floor((self.seconds % 3600) / 60)
  local s = self.seconds % 60
  self.time:SetText(string.format("%02d:%02d:%02d", h, m, s))
end
