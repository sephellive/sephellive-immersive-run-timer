-- Immersive Run Timer. Persistent, save-safe and independent of the UI layout.
local KEY = "sep_immersive_run_timer.seconds"
sep_immersive_run_timer_hud = nil

function on_game_start()
  RegisterScriptCallback("actor_on_first_update", function() activate_timer() end)
  RegisterScriptCallback("actor_on_net_destroy", function() deactivate_timer() end)
end

function activate_timer()
  if sep_immersive_run_timer_hud then return end
  sep_immersive_run_timer_hud = SepRunTimer()
  get_hud():AddDialogToRender(sep_immersive_run_timer_hud)
end

function deactivate_timer()
  if sep_immersive_run_timer_hud then
    get_hud():RemoveDialogToRender(sep_immersive_run_timer_hud)
    sep_immersive_run_timer_hud = nil
  end
end

class "SepRunTimer" (CUIScriptWnd)
function SepRunTimer:__init() super()
  self:SetWndRect(Frect():set(0, 0, 1024, 768))
  -- Match NewRunTimer: when this addon is first installed mid-run, begin from
  -- Anomaly's recorded time for the current playthrough instead of 00:00:00.
  self.seconds = load_var(db.actor, KEY)
  if not self.seconds then
    self.seconds = utils_obj.time_spent_in_zone(1) / level.get_time_factor()
    save_var(db.actor, KEY, self.seconds)
  end
  self.last = time_global()
  local xml = CScriptXmlInit(); xml:ParseFile("sep_immersive_run_timer.xml")
  self.panel = xml:InitStatic("panel", self)
  self.time = xml:InitTextWnd("panel:time", self.panel)
  self:refresh_layout()
end

function SepRunTimer:refresh_position()
  local x = ui_mcm and ui_mcm.get("sep_immersive_run_timer/pos_x") or 20
  local y = ui_mcm and ui_mcm.get("sep_immersive_run_timer/pos_y") or 20
  self.panel:SetWndPos(vector2():set(x, y))
end

function SepRunTimer:refresh_font()
  local scale = ui_mcm and ui_mcm.get("sep_immersive_run_timer/font_scale") or 2
  local fonts = {GetFontSmall(), GetFontLetterica16Russian(), GetFontGraffiti19Russian(), GetFontGraffiti22Russian()}
  self.time:SetFont(fonts[scale] or fonts[1])
  -- Plain Text has no artwork, so its container grows with the selected font.
  if sep_immersive_run_timer_plain then
    local factors = {0.60, 0.75, 0.90, 1.05}
    local factor = factors[scale] or factors[1]
    self.panel:SetWndSize(vector2():set(132 * factor, 26 * factor))
    self.time:SetWndSize(vector2():set(132 * factor, 26 * factor))
  end
end

function SepRunTimer:refresh_layout()
  self:refresh_position()
  self:refresh_font()
end

function SepRunTimer:sync_mcm_layout()
  local x = ui_mcm and ui_mcm.get("sep_immersive_run_timer/pos_x") or 20
  local y = ui_mcm and ui_mcm.get("sep_immersive_run_timer/pos_y") or 20
  local scale = ui_mcm and ui_mcm.get("sep_immersive_run_timer/font_scale") or 2
  if x ~= self.mcm_x or y ~= self.mcm_y or scale ~= self.mcm_scale then
    self.mcm_x, self.mcm_y, self.mcm_scale = x, y, scale
    self:refresh_layout()
  end
end

function SepRunTimer:Update()
  CUIScriptWnd.Update(self)
  -- MCM is a separate script environment. Polling its values here moves the real HUD immediately.
  self:sync_mcm_layout()
  local now = time_global()
  if now - self.last < 1000 then return end
  self.seconds = self.seconds + math.floor((now - self.last) / 1000)
  self.last = now
  save_var(db.actor, KEY, self.seconds)
  local h = math.floor(self.seconds / 3600)
  local m = math.floor((self.seconds % 3600) / 60)
  local s = self.seconds % 60
  self.time:SetText(string.format("%02d:%02d:%02d", h, m, s))
end
