-- MCM page and live positioning controller. The _mcm suffix makes it discoverable.
local positioner_gui = nil

local function path(key) return "sep_immersive_run_timer/" .. key end
local function level_present() return level.present() end
local commands = {
  {key = "pos_x", min = 0, max = 1000, step = 1, def = 20},
  {key = "pos_y", min = 0, max = 760, step = 1, def = 20},
  {key = "font_scale", min = 1, max = 4, step = 1, def = 2},
}

local function apply(key, value)
  if ui_mcm then ui_mcm.set(path(key), value) end
  if sep_immersive_run_timer_hud then sep_immersive_run_timer_hud:refresh_layout() end
end

function on_mcm_load(options)
  local op = {id = "sep_immersive_run_timer", sh = true, gr = {
    {id = "title", type = "title", text = "ui_mcm_sep_immersive_run_timer_title"},
    {id = "hint", type = "text", text = "ui_mcm_sep_immersive_run_timer_hint"},
    {id = "pos_x", type = "track", val = 2, def = 20, min = 0, max = 1000, step = 1},
    {id = "pos_y", type = "track", val = 2, def = 20, min = 0, max = 760, step = 1},
    {id = "font_scale", type = "track", val = 2, def = 2, min = 1, max = 4, step = 1},
    {id = "preview", type = "button", functor_ui = {start_ui}, precondition = {level_present}},
  }}
  return op
end

function on_option_change()
  if not ui_mcm then return end
  for _, command in ipairs(commands) do apply(command.key, ui_mcm.get(path(command.key)) or command.def) end
end

function start_ui(self)
  if self and self.On_Cancel then self:On_Cancel() end
  if not level.present() then return end
  exec_console_cmd("main_menu off")
  if not positioner_gui then positioner_gui = RunTimerPositionControl() end
  if not positioner_gui:IsShown() then
    positioner_gui:ShowDialog(true)
    Register_UI("RunTimerPositionControl", "sep_immersive_run_timer_mcm")
  end
end

class "RunTimerPositionControl" (CUIScriptWnd)
function RunTimerPositionControl:__init() super()
  self:InitControls()
  RegisterScriptCallback("actor_on_net_destroy", self)
end
function RunTimerPositionControl:__finalize() positioner_gui = nil end
function RunTimerPositionControl:actor_on_net_destroy() self:Close() end

function RunTimerPositionControl:InitControls()
  self:SetWndRect(Frect():set(0, 0, 1024, 768)); self:SetAutoDelete(true)
  local xml = CScriptXmlInit(); xml:ParseFile("ui_options.xml")
  self.dialog = xml:InitStatic("ctrl_lighting", self)
  xml:InitFrame("ctrl_lighting:frame", self.dialog)
  local title = xml:InitStatic("ctrl_lighting:cap_main", self.dialog)
  title:TextControl():SetText(game.translate_string("ui_mcm_sep_immersive_run_timer_preview_title"))
  self.scroll = xml:InitScrollView("ctrl_lighting:scroll", self.dialog); self.scroll:Clear()
  self.track, self.value = {}, {}
  for i, command in ipairs(commands) do
    local row = xml:InitStatic("ctrl_lighting:st", nil)
    local caption = xml:InitStatic("ctrl_lighting:cap", row)
    caption:TextControl():SetText(game.translate_string("ui_mcm_sep_immersive_run_timer_" .. command.key))
    local value = ui_mcm.get(path(command.key)) or command.def
    self.track[i] = xml:InitTrackBar("ctrl_lighting:track", row)
    self.track[i]:SetStep(command.step); self.track[i]:SetOptFBounds(command.min, command.max); self.track[i]:SetFValue(value)
    self.value[i] = value
    local number = xml:InitTextWnd("ctrl_lighting:num", row); number:SetText(value); self["number_" .. i] = number
    self.scroll:AddWindow(row, true); row:SetAutoDelete(true)
  end
end

function RunTimerPositionControl:Update()
  CUIScriptWnd.Update(self)
  for i, track in ipairs(self.track) do
    if track:IsCursorOverWindow() then
      local value = round_idp(track:GetFValue(), 0)
      if value ~= self.value[i] then
        self.value[i] = value; apply(commands[i].key, value); self["number_" .. i]:SetText(value)
      end
    end
  end
end

function RunTimerPositionControl:OnKeyboard(dik, keyboard_action)
  local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
  if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then self:Close() end
  return res
end
function RunTimerPositionControl:Close()
  self:HideDialog(); self:Show(false); Unregister_UI("RunTimerPositionControl"); positioner_gui = nil
end
